{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "nixpacks.toml",
    "nixpacksPlan": {
      "variables": {
        "NIXPACKS_PYTHON_VERSION": "3.10"
      },
      "providers": ["python"],
      "phases": {
        "setup": {
          "nixPkgs": ["python310", "nodejs", "gcc", "pkg-config", "freetype"],
          "nixLibs": ["freetype.dev"],
          "aptPkgs": ["libfreetype6-dev"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "python manage.py migrate && python manage.py collectstatic --noinput && gunicorn iPLMver2.wsgi",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
